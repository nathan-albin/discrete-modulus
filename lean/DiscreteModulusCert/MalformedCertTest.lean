import DiscreteModulusCert.CertChecker

/-!
# Negative tests: `checkCertificateJson` actually rejects broken certificates

Every other test file exercises the *accept* path (`CertCheckerTest.lean`'s
smoke tests, `EndToEndTest.lean`'s soundness-linked proofs): a
certificate, and confirmation that `checkCertificateJson` says so. None of
them confirm the converse -- that a certificate breaking one specific
invariant actually gets rejected, rather than slipping through by
accident. This file does that, one broken invariant at a time, each
starting from `house`'s own real certificate
(`cpp/examples/house.certificate.json`) with exactly one thing wrong
(`testdata/malformed/*.json`, generated by mutating a fresh copy of the
real certificate and, where needed, recomposing `eta`/`rho` so only the
intended invariant is broken -- see each fixture's own comment below).

**Two of these four are the actual point.** `house_bad_eta` and
`house_edge_from_other_piece` are also rejected by
`certificate_builder.validate_certificate`, the untrusted Python-side
sanity check -- unsurprising, since both break a bookkeeping invariant
that check does look at. `house_nonmaximal_tree` and
`house_nonoptimal_pmf` are *not*: confirmed by hand, running
`validate_certificate` directly against both fixtures while building this
file, that Python's own check accepts them. It never independently
confirms a declared tree is actually a spanning tree of its piece (only
that it's a subset of the piece's edges), and never checks
optimality/admissibility at all (only that the declared `eta`/`rho`
compose correctly from `pieces`, which a self-consistently-recomputed
`eta`/`rho` always will, optimal or not). Only this Lean checker's
`checkTree` maximality check and Kruskal-based admissibility check catch
those two -- the actual reason a Lean proof, not just the Python
sanity-check, is the trusted layer here.
-/

open DiscreteModulusCert.CertChecker

def badEtaJson : String :=
  include_str "testdata/malformed/house_bad_eta.certificate.json"

def edgeFromOtherPieceJson : String :=
  include_str "testdata/malformed/house_edge_from_other_piece.certificate.json"

def nonmaximalTreeJson : String :=
  include_str "testdata/malformed/house_nonmaximal_tree.certificate.json"

def nonoptimalPmfJson : String :=
  include_str "testdata/malformed/house_nonoptimal_pmf.certificate.json"

/-- `Except.isOk`, spelled out locally so this file doesn't depend on
which core/Batteries module happens to define it. -/
def isError (r : Except String (Nat × Nat × UInt64)) : Bool :=
  match r with
  | .error _ => true
  | .ok _ => false

/- Printed diagnostics, the same style `CertCheckerTest.lean` uses: not
themselves a pass/fail check (that's the `native_decide` obligations
below), just the rejection reason for a human reading the build log. -/
#eval do
  match checkCertificateJson badEtaJson with
  | .ok _ => IO.println "house_bad_eta: unexpectedly ACCEPTED"
  | .error e => IO.println s!"house_bad_eta: REJECTED: {e}"

#eval do
  match checkCertificateJson edgeFromOtherPieceJson with
  | .ok _ => IO.println "house_edge_from_other_piece: unexpectedly ACCEPTED"
  | .error e => IO.println s!"house_edge_from_other_piece: REJECTED: {e}"

#eval do
  match checkCertificateJson nonmaximalTreeJson with
  | .ok _ => IO.println "house_nonmaximal_tree: unexpectedly ACCEPTED"
  | .error e => IO.println s!"house_nonmaximal_tree: REJECTED: {e}"

#eval do
  match checkCertificateJson nonoptimalPmfJson with
  | .ok _ => IO.println "house_nonoptimal_pmf: unexpectedly ACCEPTED"
  | .error e => IO.println s!"house_nonoptimal_pmf: REJECTED: {e}"

/-- A single declared `eta` entry no longer matches what the pieces
themselves compose to (edge 0: pieces still say `2/3`, the certificate
now claims `1/2`). Rejected at the `eta` consistency check. -/
theorem house_bad_eta_rejected : isError (checkCertificateJson badEtaJson) = true := by
  native_decide

/-- Piece 0's first tree swaps in edge 3, which belongs to piece 1, in
place of edge 1. Rejected by `checkTree`'s own `T.all (· ∈ A)` check
("tree uses an edge outside its own piece") before `eta`/`rho` are even
recomputed. -/
theorem house_edge_from_other_piece_rejected :
    isError (checkCertificateJson edgeFromOtherPieceJson) = true := by
  native_decide

/-- Piece 0's first tree drops edge 1, leaving a single edge that spans
only 2 of the piece's 3 vertices -- not a spanning tree of the piece,
merely a sub-forest of one. `eta`/`rho` are recomputed from these same
(broken) pieces, so they're internally self-consistent; only the
maximality half of `checkTree` (edge 1 could still be added without
creating a cycle) catches this. -/
theorem house_nonmaximal_tree_rejected :
    isError (checkCertificateJson nonmaximalTreeJson) = true := by
  native_decide

/-- Piece 0's local pmf is skewed (`1/2, 1/4, 1/4` instead of the optimal
`1/3, 1/3, 1/3`) -- still three spanning trees of the piece,
still nonnegative weights summing to 1, just not the optimal
distribution. `eta`/`rho` are recomputed from these (still valid, just
suboptimal) pieces. Confirmed by brute force over every spanning tree of
the whole `house` graph (enumerated directly, by hand, while building
this fixture) that the resulting `rho` is *not* admissible: the spanning
tree using edges `{0, 2, 3, 4}` has `rho`-weight `62/65 < 1`. Rejected by
the Kruskal-based admissibility check -- the one check with no
Python-side counterpart at all. -/
theorem house_nonoptimal_pmf_rejected :
    isError (checkCertificateJson nonoptimalPmfJson) = true := by
  native_decide
